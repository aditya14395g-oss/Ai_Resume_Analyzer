<!-- Resume Upload Page -->
<% layout("/layouts/boilerplate") %>

<div class="container mt-5 text-center">

    <h1 class="display-5">
        Upload Your Resume
    </h1>

    <p class="lead">
        Upload your PDF resume and get AI-powered analysis.
    </p>

    <form action="/resume/upload" 
          method="POST" 
          enctype="multipart/form-data">

        <input 
            type="file"
            name="resume"
            accept=".pdf"
            class="form-control w-50 mx-auto"
            required
        >

        <button class="btn btn-primary btn-lg mt-3">
            Analyze Resume
        </button>

    </form>

</div>