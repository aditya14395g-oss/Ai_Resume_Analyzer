<% layout("/layouts/boilerplate") %>

<h2 class="mb-4">Signup</h2>

<form action="/signup" method="POST">

<div class="mb-3">
    <input
        type="text"
        name="username"
        class="form-control"
        placeholder="Username"
        required>
</div>

<div class="mb-3">
    <input
        type="email"
        name="email"
        class="form-control"
        placeholder="Email"
        required>
</div>

<div class="mb-3">
    <input
        type="password"
        name="password"
        class="form-control"
        placeholder="Password"
        required>
</div>

<button class="btn btn-primary">
    Signup
</button>

</form>